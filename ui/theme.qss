/* ui/theme.qss */

/*
 * Design Tokens
 * --bg: #0B0F14
 * --card: #111826
 * --primary: #1FA2FF
 * --accent: #22C55E
 * --warn: #F59E0B
 * --error: #EF4444
 * --text: #E5E7EB
 * --muted: #94A3B8
 */

QWidget {
    color: #E5E7EB; /* --text */
    font-family: "Segoe UI", "Roboto", "Noto Sans", sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #0B0F14; /* --bg */
}

QGroupBox, QFrame {
    background-color: #111826; /* --card */
    border-radius: 8px;
    border: 1px solid #1f2937; /* A slightly lighter border */
    padding: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    font-size: 16px;
    font-weight: bold;
    color: #1FA2FF; /* --primary */
}

QLabel {
    background-color: transparent;
}

QLineEdit, QTextEdit, QComboBox {
    background-color: #1f2937;
    border: 1px solid #374151;
    border-radius: 4px;
    padding: 5px;
    font-size: 14px;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #1FA2FF; /* --primary */
    outline: none;
}

QPushButton {
    background-color: #1FA2FF; /* --primary */
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #47b3ff;
}

QPushButton:pressed {
    background-color: #008ae6;
}

QTabWidget::pane {
    border: none;
}

QTabBar::tab {
    background: #111826; /* --card */
    color: #94A3B8; /* --muted */
    padding: 10px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: #E5E7EB; /* --text */
    border-bottom: 2px solid #1FA2FF; /* --primary */
}

QStatusBar {
    background-color: #111826;
    color: #94A3B8;
}
